{
  "name": "baqara-family",
  "version": "0.1.0",
  "private": true,
  "description": "Private family app for reading Surah Al-Baqarah every day",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/index.js & vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "seed:demo": "node scripts/seed-demo.js",
    "fetch:quran": "node scripts/fetch-quran.js",
    "verify:quran": "node scripts/verify-quran.js",
    "test": "node --test tests/api.test.js",
    "test:e2e": "node --test tests/e2e.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "supertest": "^7.3.2",
    "vite": "^8.3.8"
  }
}
